# ==============================================================================
# Variáveis de Ambiente do Sistema - freetoken-next
# Copie este arquivo para ".env" e não o commite no repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ALOCAÇÃO E COMPORTAMENTO DE HARDWARE / VRAM
# ------------------------------------------------------------------------------

# Diretório mandatório para arquivos temporários, caches e checkpoints.
# AVISO: Nunca deixe o sistema usar /tmp (tmpfs) pois consome a RAM real do host,
# que é necessária para os Expert Banks (MoE offload) e PLE tables.
TMPDIR=/models/desenvolvimento/tmp
UV_CACHE_DIR=/models/desenvolvimento/.uvcache

# Proporção máxima de VRAM a ser usada pelo sistema. O valor seguro medido
# para o Flash-Next na RTX 5080 é 0.9. O restante fica como margem para transientes.
FREETOKEN_MEMORY_RATIO=0.9

# ------------------------------------------------------------------------------
# 2. SCHEDULER E MULTI-TOKEN PREDICTION (MTP)
# ------------------------------------------------------------------------------

# Desativa o "overlap scheduling" (sobreposição de CPU/GPU).
# Obrigatório quando MTP k=1 ou maior está ativo com cache-type naive
# para evitar CUDA Graph errors e hangs no decode spec loop.
FREETOKEN_DISABLE_OVERLAP_SCHEDULING=1

# ------------------------------------------------------------------------------
# 3. DEBUG E LOGS (Opcionais)
# ------------------------------------------------------------------------------

# Ativa mensagens adicionais para o backend de TurboKV e Kernel Cache
# FREETOKEN_KERNEL_CACHE_VERBOSE=1
